&spi0{

	cs-gpios = <&gpio1 0 0>;


	bme280_0: bme280@0{

		compatible = "org,bme280";
		reg<0>;
		spi-max-frequency = <10000000>;
		label = "SPI0:bme280-0";
		spi-cpol = <0>;
		spi-cpha = <0>;


	};

	bme280_1: bme280@1{

                compatible = "org,bme280";
                reg<1>;
		spi-max-frequency = <10000000>;
                label = "SPI0:bme280-1";
                spi-cpol = <0>;
                spi-cpha = <0>;

	};
};
